{
    "//":"模组类型 目前支持:'car'/'map/(TODO:待补充)' (需小写) ",
    "ModType":"map",
    
    "//":"默认操作 当文件所在的路径没有被包含在rules时 会执行这里的操作,且不支持rename操作,因为rename只对单一文件/目录生效",
    "defaultAction":  {"action": "skip","backup": false},
    "//":"pattern fidle:匹配规则 | action filed:要对满足该匹配规则的文件执行的操作",
    "rules": [
        { "pattern": "*.txt", "action": "skip", "backup": false },
        { "pattern": "skins/**", "action": "overwrite", "backup": true },
        { "pattern": "some_old.acd", "action": "rename", "newName": "data.acd", "backup": false },
        { "pattern": "unwanted_wrapper/content", "action": "overwrite", "target": "content", "backup": false },

        {"//":"目前ask暂未实现"},
        {"pattern": "*.ini", "action": "backup"},
        {"pattern": "2.png", "action": "ask","newName":".cfg","backup": false}
    ],
    "//":"覆盖的起始位置 以Assetto Corsa Root File为根目录 缺省值为context",
    "OverwriteStartingDir":"content/car"
}