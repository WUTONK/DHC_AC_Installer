{
    "//":"模组类型 目前支持:'car'/'map' ",
    "modType":"car",
    "//":"默认操作 当文件所在的路径没有被包含在rules时 会执行这里的操作",
    "defaultAction":  {"action": "overwrite","backup": false},
    "//":"pattern fidle:匹配规则 | action filed:要对满足该匹配规则的文件执行的操作",
    "rules": [
        {"pattern": "*.acd", "action": "rename","newName":".cfg","backup": false},
        {"pattern": "*.txt", "action": "backup", "backup": true},
        {"pattern": "/car", "action": "rename", "newName":"recar","backup": false}
    ],
    "//":"覆盖的起始位置 以Assetto Corsa Root File为根目录 缺省值为context",
    "overwriteStartingDir":"content/car"
}