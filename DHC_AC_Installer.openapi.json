{
  "openapi": "3.0.1",
  "info": {
    "title": "DHC AC Installer API",
    "description": "一键式安装前后端API接口规范",
    "version": "1.0.0"
  },
  "tags": [
    {
      "name": "System",
      "description": "系统信息相关接口"
    },
    {
      "name": "Installation",
      "description": "安装相关接口"
    },
    {
      "name": "Progress",
      "description": "进度查询接口"
    },
    {
      "name": "Logs",
      "description": "日志相关接口"
    }
  ],
  "paths": {
    "/api/GetGamePath": {
      "get": {
        "summary": "获取游戏路径",
        "deprecated": false,
        "description": "获取游戏存储路径",
        "tags": ["System"],
        "parameters": [],
        "responses": {
          "200": {
            "description": "成功返回游戏路径",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetGamePathResp"
                }
              }
            },
            "headers": {}
          }
        },
        "security": []
      }
    },
    "/api/GetDiskInfo": {
      "get": {
        "summary": "获取磁盘信息",
        "description": "获取当前磁盘信息和可用空间",
        "tags": ["System"],
        "parameters": [
          {
            "name": "drive",
            "in": "query",
            "description": "磁盘盘符，例如 'C:', 'D:'。如果为空则返回默认磁盘信息",
            "required": false,
            "schema": {
              "type": "string",
              "example": "D:"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功返回磁盘信息",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetDiskInfoResp"
                }
              }
            }
          },
          "400": {
            "description": "请求参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResp"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/GetInstallVersions": {
      "get": {
        "summary": "获取安装版本列表",
        "description": "获取三种安装模式（基础极速版、标准推荐版、豪华全享版）的详细信息",
        "tags": ["Installation"],
        "parameters": [],
        "responses": {
          "200": {
            "description": "成功返回安装版本列表",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetInstallVersionsResp"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/CheckCMStatus": {
      "get": {
        "summary": "检查CM安装状态",
        "description": "检查Content Manager是否已安装",
        "tags": ["Installation"],
        "parameters": [],
        "responses": {
          "200": {
            "description": "成功返回CM状态",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckCMStatusResp"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/InstallCM": {
      "post": {
        "summary": "开始安装CM",
        "description": "开始下载并安装Content Manager",
        "tags": ["Installation"],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InstallCMReq"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功启动CM安装",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InstallCMResp"
                }
              }
            }
          },
          "400": {
            "description": "安装失败或已在安装中",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResp"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/GetCMInstallProgress": {
      "get": {
        "summary": "获取CM安装进度",
        "description": "获取Content Manager的安装进度",
        "tags": ["Progress"],
        "parameters": [],
        "responses": {
          "200": {
            "description": "成功返回CM安装进度",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCMInstallProgressResp"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/StartInstall": {
      "post": {
        "summary": "开始一键式安装",
        "description": "根据选择的版本开始安装流程",
        "tags": ["Installation"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartInstallReq"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功启动安装",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartInstallResp"
                }
              }
            }
          },
          "400": {
            "description": "安装启动失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResp"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/GetInstallProgress": {
      "get": {
        "summary": "获取总体安装进度",
        "description": "获取一键式安装的总体进度信息",
        "tags": ["Progress"],
        "parameters": [
          {
            "name": "installId",
            "in": "query",
            "description": "安装任务ID，如果为空则返回最新安装任务的进度",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功返回安装进度",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetInstallProgressResp"
                }
              }
            }
          },
          "404": {
            "description": "未找到安装任务",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResp"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/GetCarPackProgress": {
      "get": {
        "summary": "获取车包安装进度",
        "description": "获取车辆包的安装进度",
        "tags": ["Progress"],
        "parameters": [
          {
            "name": "installId",
            "in": "query",
            "description": "安装任务ID",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功返回车包安装进度",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCarPackProgressResp"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/GetShaderProgress": {
      "get": {
        "summary": "获取光影安装进度",
        "description": "获取光影模组的安装进度",
        "tags": ["Progress"],
        "parameters": [
          {
            "name": "installId",
            "in": "query",
            "description": "安装任务ID",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功返回光影安装进度",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetShaderProgressResp"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/GetMapProgress": {
      "get": {
        "summary": "获取地图安装进度",
        "description": "获取地图包的安装进度",
        "tags": ["Progress"],
        "parameters": [
          {
            "name": "installId",
            "in": "query",
            "description": "安装任务ID",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功返回地图安装进度",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetMapProgressResp"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/GetCarProgress": {
      "get": {
        "summary": "获取车辆安装进度",
        "description": "获取单个车辆的安装进度",
        "tags": ["Progress"],
        "parameters": [
          {
            "name": "installId",
            "in": "query",
            "description": "安装任务ID",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "carName",
            "in": "query",
            "description": "车辆名称，如果指定则返回特定车辆的进度",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功返回车辆安装进度",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetCarProgressResp"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/GetInstallLogs": {
      "get": {
        "summary": "获取安装日志",
        "description": "获取安装过程中的日志信息，支持实时流式返回",
        "tags": ["Logs"],
        "parameters": [
          {
            "name": "installId",
            "in": "query",
            "description": "安装任务ID",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "since",
            "in": "query",
            "description": "时间戳（Unix时间戳，秒），只返回此时间之后的日志",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "返回日志条数限制，默认100",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 100,
              "minimum": 1,
              "maximum": 1000
            }
          },
          {
            "name": "level",
            "in": "query",
            "description": "日志级别过滤：info, warn, error, all",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["info", "warn", "error", "all"],
              "default": "all"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功返回安装日志",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetInstallLogsResp"
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/GetServerInfo": {
      "get": {
        "summary": "获取服务器信息",
        "deprecated": false,
        "description": "",
        "tags": ["System"],
        "parameters": [
          {
            "name": "ServerHost",
            "in": "query",
            "description": "",
            "required": false,
            "example": "1.1.1.1:8080",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "Rtt": {
                      "type": "string"
                    },
                    "Clients": {
                      "type": "number"
                    },
                    "MaxClients": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "Rtt",
                    "Clients",
                    "MaxClients"
                  ]
                }
              }
            },
            "headers": {}
          }
        },
        "security": []
      }
    }
  },
  "components": {
    "schemas": {
      "GetGamePathResp": {
        "type": "object",
        "properties": {
          "GamePath": {
            "type": "string",
            "description": "游戏安装路径"
          }
        },
        "required": [
          "GamePath"
        ]
      },
      "GetDiskInfoResp": {
        "type": "object",
        "properties": {
          "Drive": {
            "type": "string",
            "description": "磁盘盘符，例如 'C:', 'D:'",
            "example": "D:"
          },
          "Label": {
            "type": "string",
            "description": "磁盘卷标",
            "example": "Data"
          },
          "TotalBytes": {
            "type": "integer",
            "format": "int64",
            "description": "总空间（字节）"
          },
          "UsedBytes": {
            "type": "integer",
            "format": "int64",
            "description": "已用空间（字节）"
          },
          "FreeBytes": {
            "type": "integer",
            "format": "int64",
            "description": "可用空间（字节）"
          },
          "IsSSD": {
            "type": "boolean",
            "description": "是否为SSD"
          },
          "IsRemovable": {
            "type": "boolean",
            "description": "是否为可移动磁盘"
          }
        },
        "required": [
          "Drive",
          "TotalBytes",
          "UsedBytes",
          "FreeBytes"
        ]
      },
      "InstallVersion": {
        "type": "object",
        "properties": {
          "Id": {
            "type": "string",
            "description": "版本ID：minimal, standard, full",
            "enum": ["minimal", "standard", "full"]
          },
          "Name": {
            "type": "string",
            "description": "版本名称",
            "example": "标准推荐版"
          },
          "Description": {
            "type": "string",
            "description": "版本描述",
            "example": "包含首都高地图 + 常用车流 + 基础光影。最平衡的选择，推荐大多数玩家使用。"
          },
          "SizeBytes": {
            "type": "integer",
            "format": "int64",
            "description": "预计安装大小（字节）"
          },
          "Recommended": {
            "type": "boolean",
            "description": "是否为推荐版本"
          },
          "Includes": {
            "type": "object",
            "description": "包含的内容",
            "properties": {
              "CSP": {
                "type": "boolean",
                "description": "是否包含CSP"
              },
              "Sol": {
                "type": "boolean",
                "description": "是否包含Sol"
              },
              "Pure": {
                "type": "boolean",
                "description": "是否包含Pure"
              },
              "Map": {
                "type": "boolean",
                "description": "是否包含地图"
              },
              "CarPack": {
                "type": "boolean",
                "description": "是否包含车包"
              },
              "CarPack4K": {
                "type": "boolean",
                "description": "是否包含4K材质车包"
              }
            }
          }
        },
        "required": [
          "Id",
          "Name",
          "SizeBytes"
        ]
      },
      "GetInstallVersionsResp": {
        "type": "object",
        "properties": {
          "Versions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InstallVersion"
            },
            "description": "可用安装版本列表"
          }
        },
        "required": [
          "Versions"
        ]
      },
      "CheckCMStatusResp": {
        "type": "object",
        "properties": {
          "Installed": {
            "type": "boolean",
            "description": "CM是否已安装"
          },
          "Path": {
            "type": "string",
            "description": "CM安装路径（如果已安装）",
            "nullable": true
          },
          "Version": {
            "type": "string",
            "description": "CM版本（如果已安装）",
            "nullable": true
          }
        },
        "required": [
          "Installed"
        ]
      },
      "InstallCMReq": {
        "type": "object",
        "properties": {
          "Force": {
            "type": "boolean",
            "description": "是否强制重新安装（即使已安装）",
            "default": false
          }
        }
      },
      "InstallCMResp": {
        "type": "object",
        "properties": {
          "Success": {
            "type": "boolean",
            "description": "是否成功启动安装"
          },
          "InstallId": {
            "type": "string",
            "description": "安装任务ID，用于查询进度"
          },
          "Message": {
            "type": "string",
            "description": "返回消息"
          }
        },
        "required": [
          "Success",
          "InstallId"
        ]
      },
      "GetCMInstallProgressResp": {
        "type": "object",
        "properties": {
          "Status": {
            "type": "string",
            "enum": ["idle", "downloading", "extracting", "installing", "completed", "failed"],
            "description": "安装状态：idle=空闲, downloading=下载中, extracting=解压中, installing=安装中, completed=已完成, failed=失败"
          },
          "Progress": {
            "type": "number",
            "format": "float",
            "minimum": 0,
            "maximum": 100,
            "description": "安装进度百分比（0-100）"
          },
          "StatusText": {
            "type": "string",
            "description": "状态描述文本",
            "example": "正在下载 Content Manager... 45%"
          },
          "DownloadedBytes": {
            "type": "integer",
            "format": "int64",
            "description": "已下载字节数",
            "nullable": true
          },
          "TotalBytes": {
            "type": "integer",
            "format": "int64",
            "description": "总字节数",
            "nullable": true
          },
          "Error": {
            "type": "string",
            "description": "错误信息（如果状态为failed）",
            "nullable": true
          }
        },
        "required": [
          "Status",
          "Progress"
        ]
      },
      "StartInstallReq": {
        "type": "object",
        "properties": {
          "VersionId": {
            "type": "string",
            "enum": ["minimal", "standard", "full"],
            "description": "要安装的版本ID"
          },
          "GamePath": {
            "type": "string",
            "description": "游戏安装路径（可选，如果为空则使用自动检测的路径）",
            "nullable": true
          },
          "CleanInstall": {
            "type": "boolean",
            "description": "是否使用纯净安装模式（会先清理现有模组）",
            "default": false
          }
        },
        "required": [
          "VersionId"
        ]
      },
      "StartInstallResp": {
        "type": "object",
        "properties": {
          "Success": {
            "type": "boolean",
            "description": "是否成功启动安装"
          },
          "InstallId": {
            "type": "string",
            "description": "安装任务ID，用于查询进度和日志"
          },
          "Message": {
            "type": "string",
            "description": "返回消息"
          }
        },
        "required": [
          "Success",
          "InstallId"
        ]
      },
      "InstallCategoryProgress": {
        "type": "object",
        "properties": {
          "CategoryId": {
            "type": "string",
            "description": "类别ID：core, weather, map, cars等"
          },
          "CategoryName": {
            "type": "string",
            "description": "类别名称",
            "example": "基础环境 (CSP)"
          },
          "Status": {
            "type": "string",
            "enum": ["waiting", "active", "completed", "failed"],
            "description": "状态：waiting=等待中, active=进行中, completed=已完成, failed=失败"
          },
          "Progress": {
            "type": "number",
            "format": "float",
            "minimum": 0,
            "maximum": 100,
            "description": "进度百分比（0-100）"
          },
          "CurrentItem": {
            "type": "string",
            "description": "当前正在处理的子项名称",
            "nullable": true,
            "example": "CSP v0.1.79"
          },
          "TotalItems": {
            "type": "integer",
            "description": "总子项数量"
          },
          "CompletedItems": {
            "type": "integer",
            "description": "已完成子项数量"
          }
        },
        "required": [
          "CategoryId",
          "CategoryName",
          "Status",
          "Progress"
        ]
      },
      "GetInstallProgressResp": {
        "type": "object",
        "properties": {
          "InstallId": {
            "type": "string",
            "description": "安装任务ID"
          },
          "VersionId": {
            "type": "string",
            "description": "安装版本ID"
          },
          "Status": {
            "type": "string",
            "enum": ["idle", "preparing", "installing", "completed", "failed", "cancelled"],
            "description": "总体状态"
          },
          "TotalProgress": {
            "type": "number",
            "format": "float",
            "minimum": 0,
            "maximum": 100,
            "description": "总进度百分比（0-100）"
          },
          "Categories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InstallCategoryProgress"
            },
            "description": "各类别的安装进度"
          },
          "StartTime": {
            "type": "integer",
            "format": "int64",
            "description": "开始时间（Unix时间戳，秒）"
          },
          "EndTime": {
            "type": "integer",
            "format": "int64",
            "description": "结束时间（Unix时间戳，秒），如果未完成则为null",
            "nullable": true
          },
          "Error": {
            "type": "string",
            "description": "错误信息（如果状态为failed）",
            "nullable": true
          }
        },
        "required": [
          "InstallId",
          "Status",
          "TotalProgress"
        ]
      },
      "CarPackItemProgress": {
        "type": "object",
        "properties": {
          "CarName": {
            "type": "string",
            "description": "车辆名称",
            "example": "Nissan Skyline R34"
          },
          "Status": {
            "type": "string",
            "enum": ["waiting", "installing", "completed", "failed"],
            "description": "状态"
          },
          "Progress": {
            "type": "number",
            "format": "float",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "CarName",
          "Status",
